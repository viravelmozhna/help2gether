{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "demands": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["assignedTo", "status", "category", "emergency"]
    },
    "publicDemands": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["assignedTo", "status", "category", "emergency"]
    }
  }
}
